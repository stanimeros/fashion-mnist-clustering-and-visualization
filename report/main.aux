\@writefile{toc}{\contentsline {section}{\numberline {2}Dataset}{2}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Random samples from Fashion-MNIST, one row per class. Several classes are genuinely hard to distinguish: pullover / coat / shirt share the same torso silhouette, and sneaker / sandal / ankle-boot look like a small dark blob at this resolution. This inherent class overlap is the practical upper bound on what any unsupervised method can recover.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:samples}{{1}{2}{Random samples from Fashion-MNIST, one row per class. Several classes are genuinely hard to distinguish: pullover / coat / shirt share the same torso silhouette, and sneaker / sandal / ankle-boot look like a small dark blob at this resolution. This inherent class overlap is the practical upper bound on what any unsupervised method can recover}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Dimensionality Reduction Methods}{2}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}PCA Explained Variance}{3}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cumulative explained variance of PCA. The curve rises steeply in the first 20--30 components and then flattens; $\approx $85 components are needed to retain 95\% of the variance. PCA cannot untangle non-linearly mixed classes in pixel space.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:pca_var}{{2}{3}{Cumulative explained variance of PCA. The curve rises steeply in the first 20--30 components and then flattens; $\approx $85 components are needed to retain 95\% of the variance. PCA cannot untangle non-linearly mixed classes in pixel space}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}SAE Reconstructions}{3}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces SAE reconstructions (top: originals, bottom: decoded through a 32-D bottleneck). Global silhouettes are recovered but fine textures (stripes, laces) are blurred away.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:sae_recon}{{3}{3}{SAE reconstructions (top: originals, bottom: decoded through a 32-D bottleneck). Global silhouettes are recovered but fine textures (stripes, laces) are blurred away}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}CNN-SAE Reconstructions}{4}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CNN-SAE reconstructions. Edges and textures are visibly sharper than the dense SAE because convolutions exploit the 2-D pixel structure and learn translation-invariant filters. This fidelity is reflected downstream in better Adjusted Rand scores.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:cnnsae_recon}{{4}{4}{CNN-SAE reconstructions. Edges and textures are visibly sharper than the dense SAE because convolutions exploit the 2-D pixel structure and learn translation-invariant filters. This fidelity is reflected downstream in better Adjusted Rand scores}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}UMAP 2-D Projection}{4}{subsection.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 2-D UMAP projection coloured by ground-truth class. Footwear, trousers, and bags form clearly detached islands. The three upper-body classes (shirt / pullover / coat) remain partially mixed — confirming that the remaining confusion is intrinsic to the dataset, not a failure of the embedding.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:umap2d}{{5}{4}{2-D UMAP projection coloured by ground-truth class. Footwear, trousers, and bags form clearly detached islands. The three upper-body classes (shirt / pullover / coat) remain partially mixed — confirming that the remaining confusion is intrinsic to the dataset, not a failure of the embedding}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Clustering Algorithms}{4}{section.4}\protected@file@percent }
